<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_background" android:padding="10dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop"
        android:background="@drawable/widget_art_background" android:clipToOutline="true" android:contentDescription="@string/album_art" android:src="@drawable/widget_record" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_music" android:textColor="#9EDDD3" android:textSize="9sp" android:singleLine="true" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#F7F6F0" android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_choose_music" android:textColor="#B2C4C7" android:textSize="11sp" android:singleLine="true"
            android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_previous" android:layout_width="36dp" android:layout_height="48dp"
        android:background="@drawable/widget_button" android:src="@drawable/widget_previous" android:contentDescription="@string/previous" android:padding="8dp" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="2dp"
        android:background="@drawable/widget_play_background" android:src="@drawable/widget_play" android:contentDescription="@string/play_pause" android:padding="10dp" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="48dp"
        android:background="@drawable/widget_button" android:src="@drawable/widget_next" android:contentDescription="@string/next" android:padding="8dp" />
</LinearLayout>
